# Copy to .env for an existing database, or run scripts/Setup-LocalDatabase.ps1.
DATABASE_URL=postgresql://ipo_platform_api:CHANGE_ME@localhost:5432/ipo_platform?sslmode=disable
MIGRATION_DATABASE_URL=postgresql://ipo_platform_owner:CHANGE_ME@localhost:5432/ipo_platform?sslmode=disable
WHATSAPP_DATABASE_URL=postgresql://ipo_platform_owner:CHANGE_ME@localhost:5432/ipo_platform?sslmode=disable
API_ADDR=127.0.0.1:8180
# New numbers sign up through WhatsApp approval only in development. Default: production.
APP_ENV=development
# Disabled by default. Enable only for local bootstrap/legacy migration.
ALLOW_PASSWORD_LOGIN=false
BOOTSTRAP_BUSINESS_NAME=Local IPO Business
BOOTSTRAP_ADMIN_NAME=Local Administrator
# Development placeholder. Set your actual international phone before bootstrapping.
BOOTSTRAP_ADMIN_PHONE=+919000000001
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
