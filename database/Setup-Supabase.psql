-- Run with psql as the project administrator, on a fresh development database.
\set ON_ERROR_STOP on
SELECT current_database() AS database_name, current_user AS setup_user \gset
BEGIN;
DO $$
BEGIN
    IF current_setting('server_version_num')::integer < 170000 THEN
        RAISE EXCEPTION 'PostgreSQL 17 or later is required';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_namespace WHERE nspname IN ('ipo_pos','whatsapp'))
        OR EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN ('ipo_platform_owner','ipo_platform_api')) THEN
        RAISE EXCEPTION 'Application schemas or roles already exist; apply only missing migrations manually';
    END IF;
END $$;
CREATE ROLE ipo_platform_owner LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
CREATE ROLE ipo_platform_api LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
GRANT ipo_platform_owner TO :"setup_user";
GRANT CONNECT, CREATE ON DATABASE :"database_name" TO ipo_platform_owner;
COMMIT;

SET ROLE ipo_platform_owner;
\ir 001_initial.sql
\ir 002_api.sql
\ir 003_whatsapp_accounts.sql
\ir 004_contact_names.sql
\ir 005_transaction_confirmations.sql
\ir 006_passwordless_sessions.sql
\ir 007_whatsapp_number_checks.sql
\ir 008_signed_transaction_quantity.sql
\ir 009_signed_transaction_rate.sql
\ir 010_development_signup.sql
\ir 011_contact_profile_push.sql
\ir 012_account_recovery.sql
\ir 013_ipo_catalogue.sql
REVOKE ALL ON SCHEMA ipo_pos, whatsapp FROM PUBLIC;
RESET ROLE;
\set api_role ipo_platform_api
\ir api_grants.sql

DO $$
BEGIN
    IF has_schema_privilege('ipo_platform_api','whatsapp','USAGE')
        OR has_table_privilege('ipo_platform_api','ipo_pos.transactions','DELETE')
        OR has_table_privilege('ipo_platform_api','ipo_pos.transactions','TRUNCATE')
        OR has_column_privilege('ipo_platform_api','ipo_pos.whatsapp_accounts','device_jid','UPDATE')
        OR has_column_privilege('ipo_platform_api','ipo_pos.login_attempts','state','UPDATE')
        OR has_table_privilege('ipo_platform_api','ipo_pos.whatsapp_number_checks','INSERT')
        OR has_table_privilege('ipo_platform_api','ipo_pos.contact_profile_revisions','UPDATE')
        OR has_table_privilege('ipo_platform_api','ipo_pos.profile_push_outbox','INSERT')
        OR pg_has_role('ipo_platform_api','ipo_platform_owner','MEMBER') THEN
        RAISE EXCEPTION 'Runtime role has excessive permissions';
    END IF;
END $$;
\echo Application schema and restricted runtime grants installed.
\echo Set passwords privately using the psql password command for both new roles.
\echo Keep ipo_pos and whatsapp out of Supabase exposed API schemas.
